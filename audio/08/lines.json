[
 {
  "text": "外婆家的後面，有一個小小的菜園。",
  "voice": "zh-HK-HiuMaanNeural"
 },
 {
  "text": "園子裏有蝴蝶飛來飛去，空氣中滿是泥土的香味。",
  "voice": "zh-HK-HiuMaanNeural"
 },
 {
  "text": "每個週末，我都會跟媽媽回去探望外婆。",
  "voice": "zh-HK-HiuMaanNeural"
 },
 {
  "text": "菜園裏種了番茄、青瓜和白菜。",
  "voice": "zh-HK-HiuMaanNeural"
 },
 {
  "text": "外婆說，番茄要曬足太陽，才會又紅又甜。",
  "voice": "zh-HK-HiuMaanNeural"
 },
 {
  "text": "有一次，我幫外婆澆水，不小心把水灑到鞋子上。",
  "voice": "zh-HK-HiuMaanNeural"
 },
 {
  "text": "我低著頭，心裏有點害怕。",
  "voice": "zh-HK-HiuMaanNeural"
 },
 {
  "text": "外婆笑著說：「沒關係，菜也在喝水呢！」",
  "voice": "zh-HK-HiuMaanNeural"
 },
 {
  "text": "我們一起摘了幾個紅紅的番茄，洗乾淨後放在桌上。",
  "voice": "zh-HK-HiuMaanNeural"
 },
 {
  "text": "我咬了一口，哇，真甜！",
  "voice": "zh-HK-HiuMaanNeural"
 },
 {
  "text": "外婆看著我，笑得眼睛都彎了。",
  "voice": "zh-HK-HiuMaanNeural"
 },
 {
  "text": "我覺得，外婆的菜園就像一個充滿愛的小天地。",
  "voice": "zh-HK-HiuMaanNeural"
 },
 {
  "text": "第1題。",
  "voice": "zh-HK-WanLungNeural"
 },
 {
  "text": "外婆屋企後面有啲乜嘢呀？",
  "voice": "zh-HK-WanLungNeural"
 },
 {
  "text": "試睇返第一段，第一句就講咗。外婆屋企後面有一個細細個嘅……？",
  "voice": "zh-HK-WanLungNeural"
 },
 {
  "text": "外婆屋企後面有一個細細個嘅菜園。",
  "voice": "zh-HK-WanLungNeural"
 },
 {
  "text": "第2題。",
  "voice": "zh-HK-WanLungNeural"
 },
 {
  "text": "菜園裏種咗啲乜嘢菜呀？講一樣都得。",
  "voice": "zh-HK-WanLungNeural"
 },
 {
  "text": "試睇返第二段，菜園裏有三種菜，其中一種係紅色嘅。",
  "voice": "zh-HK-WanLungNeural"
 },
 {
  "text": "菜園裏種咗番茄、青瓜同白菜。",
  "voice": "zh-HK-WanLungNeural"
 },
 {
  "text": "第3題。",
  "voice": "zh-HK-WanLungNeural"
 },
 {
  "text": "外婆話，番茄要點樣先會又紅又甜呀？",
  "voice": "zh-HK-WanLungNeural"
 },
 {
  "text": "同樣睇第二段，外婆話番茄要有足夠嘅乜嘢先會變甜？提示：天上面黃黃地、好光嘅嘢。",
  "voice": "zh-HK-WanLungNeural"
 },
 {
  "text": "番茄要曬足太陽，先會又紅又甜。",
  "voice": "zh-HK-WanLungNeural"
 },
 {
  "text": "第4題。",
  "voice": "zh-HK-WanLungNeural"
 },
 {
  "text": "文章裏面嘅「我」整濕咗鞋，外婆點解仲笑住話「沒關係」呀？",
  "voice": "zh-HK-WanLungNeural"
 },
 {
  "text": "試睇返第三段：「我」低住頭，心裏有啲害怕。外婆係想鬧我，定係想安慰我呢？",
  "voice": "zh-HK-WanLungNeural"
 },
 {
  "text": "因為外婆好疼我，唔想我驚，所以用有趣嘅講法安慰我。",
  "voice": "zh-HK-WanLungNeural"
 },
 {
  "text": "第5題。",
  "voice": "zh-HK-WanLungNeural"
 },
 {
  "text": "點解「我」覺得外婆嘅菜園好似一個充滿愛嘅小天地呀？",
  "voice": "zh-HK-WanLungNeural"
 },
 {
  "text": "試睇返最後一段：我哋一齊做咗啲乜？外婆對我點樣？",
  "voice": "zh-HK-WanLungNeural"
 },
 {
  "text": "因為外婆用心照顧菜園，又好疼我，我哋一齊澆水、摘番茄，覺得好溫暖。",
  "voice": "zh-HK-WanLungNeural"
 },
 {
  "text": "第6題。",
  "voice": "zh-HK-WanLungNeural"
 },
 {
  "text": "呢題冇對錯喔。如果你係文章裏面嘅「我」，你想同外婆一齊做乜？或者你同家人一齊做過乜開心嘅事呀？",
  "voice": "zh-HK-WanLungNeural"
 },
 {
  "text": "試用一句完整嘅說話答：「我想……，因為……」，多講少少都得。",
  "voice": "zh-HK-WanLungNeural"
 },
 {
  "text": "我想同外婆一齊種小花，仲想幫佢澆水，因為同家人一齊做嘢好開心。",
  "voice": "zh-HK-WanLungNeural"
 },
 {
  "text": "好叻呀！一次就答啱！",
  "voice": "zh-HK-WanLungNeural"
 },
 {
  "text": "你好叻喎！試多一次就答啱喇！",
  "voice": "zh-HK-WanLungNeural"
 },
 {
  "text": "講得好呀，多謝你同我分享！",
  "voice": "zh-HK-WanLungNeural"
 },
 {
  "text": "我嘅例子係：",
  "voice": "zh-HK-WanLungNeural"
 },
 {
  "text": "完整答案係：",
  "voice": "zh-HK-WanLungNeural"
 },
 {
  "text": "可以再講多少少嗎？",
  "voice": "zh-HK-WanLungNeural"
 },
 {
  "text": "差少少喔，唔緊要，再試吓！",
  "voice": "zh-HK-WanLungNeural"
 },
 {
  "text": "冇問題，我哋一齊睇吓答案：",
  "voice": "zh-HK-WanLungNeural"
 },
 {
  "text": "全部答啱，好叻呀！",
  "voice": "zh-HK-WanLungNeural"
 },
 {
  "text": "完成啦！你答啱咗5題入面嘅0題。",
  "voice": "zh-HK-WanLungNeural"
 },
 {
  "text": "完成啦！你答啱咗5題入面嘅1題。",
  "voice": "zh-HK-WanLungNeural"
 },
 {
  "text": "完成啦！你答啱咗5題入面嘅2題。",
  "voice": "zh-HK-WanLungNeural"
 },
 {
  "text": "完成啦！你答啱咗5題入面嘅3題。",
  "voice": "zh-HK-WanLungNeural"
 },
 {
  "text": "完成啦！你答啱咗5題入面嘅4題。",
  "voice": "zh-HK-WanLungNeural"
 },
 {
  "text": "完成啦！你答啱咗5題入面嘅5題。",
  "voice": "zh-HK-WanLungNeural"
 },
