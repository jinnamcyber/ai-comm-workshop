[
 {
  "text": "好熱呀！我變得好輕，飛上天喇！",
  "voice": "zh-HK-HiuGaaiNeural",
  "rate": "-5%"
 },
 {
  "text": "我哋手拉手，變成一朵白雲喇！",
  "voice": "zh-HK-HiuGaaiNeural",
  "rate": "-5%"
 },
 {
  "text": "朵雲好重呀！嘩，落雨喇！",
  "voice": "zh-HK-HiuGaaiNeural",
  "rate": "-5%"
 },
 {
  "text": "我流落山，入咗河，終於返到大海喇！",
  "voice": "zh-HK-HiuGaaiNeural",
  "rate": "-5%"
 },
 {
  "text": "水一路轉圈圈，呢個就叫水循環喇！",
  "voice": "zh-HK-HiuGaaiNeural",
  "rate": "-5%"
 },
 {
  "text": "蒸發！太陽曬到好熱，水變成水蒸氣，飛上天喇。",
  "voice": "zh-HK-HiuGaaiNeural",
  "rate": "-5%"
 },
 {
  "text": "凝結！水蒸氣遇到冷，就手拉手變成雲喇。",
  "voice": "zh-HK-HiuGaaiNeural",
  "rate": "-5%"
 },
 {
  "text": "降水！朵雲太重喇，水滴跌返落嚟，變成雨。",
  "voice": "zh-HK-HiuGaaiNeural",
  "rate": "-5%"
 },
 {
  "text": "匯集！雨水流入河，再流返去大海。",
  "voice": "zh-HK-HiuGaaiNeural",
  "rate": "-5%"
 },
 {
  "text": "太陽好猛呀！水蒸氣升到好高喎！",
  "voice": "zh-HK-HiuGaaiNeural",
  "rate": "-5%"
 },
 {
  "text": "好嘢！我哋變成白雲喇！",
  "voice": "zh-HK-HiuGaaiNeural",
  "rate": "-5%"
 },
 {
  "text": "嘩！落雨喇！",
  "voice": "zh-HK-HiuGaaiNeural",
  "rate": "-5%"
 },
 {
  "text": "返到大海喇！",
  "voice": "zh-HK-HiuGaaiNeural",
  "rate": "-5%"
 },
 {
  "text": "拖去藍色嗰條河度吖！",
  "voice": "zh-HK-HiuGaaiNeural",
  "rate": "-5%"
 },
 {
  "text": "你識晒水循環喇，好叻呀！",
  "voice": "zh-HK-HiuGaaiNeural",
  "rate": "-5%"
 }
]